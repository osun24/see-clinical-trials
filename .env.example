# Required. The interpretation layer has no fallback planner by design:
# without this the service returns 500 llm_misconfigured rather than
# silently answering a different question than the one asked.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown).
# OPENAI_MODEL=gpt-4.1-mini
# MAX_RECORDS=5000          # records fetched before a result is a sample
# MAX_RECORDS_HARD_CAP=10000  # safety ceiling for the configured fetch cap
# EXACT_COUNTS=true         # per-bucket exact counting where the API allows it
# CITATION_LIMIT=5          # citations attached per datum
# TOP_N=10                  # categories before collapsing into "Other"
