    "VisualizationSpec": {
      "additionalProperties": false,
      "description": "Strict renderer contract for one selected visualization type.",
      "properties": {
        "type": {
          "enum": [
            "stat",
            "bar_chart",
            "grouped_bar",
            "stacked_bar",
            "time_series",
            "pie_chart",
            "scatter_plot",
            "network_graph",
            "none"
          ],
