{
  "$defs": {
    "Channel": {
      "additionalProperties": false,
      "description": "One visual channel bound to a field on every data row.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "type": {
          "default": "nominal",
          "enum": [
            "nominal",
            "quantitative",
            "temporal"
          ],
          "title": "Type",
          "type": "string"
        },
        "axis_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Axis Title"
        },
        "legend_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legend Title"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "granularity": {
          "anyOf": [
            {
              "enum": [
                "year",
                "month"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Granularity"
        },
        "scale": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "log"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "sort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort"
        }
      },
      "required": [
        "field"
      ],
      "title": "Channel",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "A single trial record supporting one visualised datum.\n\nBuilt mechanically from the fetched JSON. ``field_value`` is the raw value\nat ``field_path`` and ``excerpt`` is a verbatim substring of a fetched\nfield \u2014 never model-generated prose, which would be a fabricated quote.",
      "properties": {
        "nct_id": {
          "title": "Nct Id",
          "type": "string"
        },
        "brief_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brief Title"
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "field_value": {
          "title": "Field Value",
          "type": "string"
        },
        "evidence_kind": {
          "default": "field_value",
          "enum": [
            "field_value",
            "text_excerpt"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "nct_id",
        "field_path",
        "field_value",
        "source_url"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "What the numbers are actually based on.\n\nClinicalTrials.gov cannot aggregate a filtered query server-side, so counts\nare computed locally over a bounded fetch. When that fetch is smaller than\nthe matching universe the response says so here, in\n``VisualizationSpec.subtitle``, and per datum via ``value_is_exact``.",
      "properties": {
        "total_matching_studies": {
          "title": "Total Matching Studies",
          "type": "integer"
        },
        "records_fetched": {
          "title": "Records Fetched",
          "type": "integer"
        },
        "records_analyzed": {
          "title": "Records Analyzed",
          "type": "integer"
        },
        "is_sample": {
          "title": "Is Sample",
          "type": "boolean"
        },
        "coverage_ratio": {
          "title": "Coverage Ratio",
          "type": "number"
        },
        "sampling_method": {
          "enum": [
            "census",
            "first_n_by_api_relevance_order",
            "stratified_by_bucket"
          ],
          "title": "Sampling Method",
          "type": "string"
        },
        "sampling_bias_risk": {
          "enum": [
            "none",
            "low",
            "high"
          ],
          "title": "Sampling Bias Risk",
          "type": "string"
        },
        "fetch_cap": {
          "title": "Fetch Cap",
          "type": "integer"
        },
        "pages_fetched": {
          "title": "Pages Fetched",
          "type": "integer"
        },
        "truncated_reason": {
          "anyOf": [
            {
              "enum": [
                "fetch_cap_reached",
                "time_budget_exceeded"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Truncated Reason"
        },
        "counts_are_exact": {
          "default": false,
          "title": "Counts Are Exact",
          "type": "boolean"
        },
        "excluded": {
          "$ref": "#/$defs/Exclusions"
        }
      },
      "required": [
        "total_matching_studies",
        "records_fetched",
        "records_analyzed",
        "is_sample",
        "coverage_ratio",
        "sampling_method",
        "sampling_bias_risk",
        "fetch_cap",
        "pages_fetched"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Datum": {
      "additionalProperties": true,
      "description": "One row of ``data``.\n\nDeclared with ``extra=\"allow\"`` because each visualization type adds its own\nkeys (for example, ``share`` for pie charts). The fields below are the ones\na renderer can rely on for any aggregated type.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "value_is_exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Is Exact"
        },
        "sample_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Value"
        },
        "is_other": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Other"
        },
        "is_missing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Missing"
        },
        "distinct_values_collapsed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct Values Collapsed"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "citation_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Total"
        },
        "citations_truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citations Truncated"
        },
        "citation_sample": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Sample"
        },
        "citation_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Basis"
        }
      },
      "title": "Datum",
      "type": "object"
    },
