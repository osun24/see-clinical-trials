    "OmittedFromGraph": {
      "additionalProperties": false,
      "description": "Trials that could not be placed on the graph, stated rather than dropped.\n\nA collapsed \"Other\" bucket has no second-dimension value, so it has no\nedge to sit on. Silently leaving it out would make the edge weights fail to\naccount for every analyzed trial with nothing in the response to say so.",
      "properties": {
        "trials": {
          "title": "Trials",
          "type": "integer"
        },
        "distinct_values_collapsed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct Values Collapsed"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "trials",
        "reason"
      ],
      "title": "OmittedFromGraph",
      "type": "object"
    },
